{{#if titleIsBeforeIcon}}
  {{#if item.localeKey}}
    <span>{{t item.localeKey}}</span>
  {{else}}
    <span>{{item.title}}</span>
  {{/if}}
{{/if}}
{{#if item.icon}}
  <i class="{{item.icon}}"></i>
{{/if}}
{{#if (not titleIsBeforeIcon)}}
  {{#if item.localeKey}}
    <span>{{t item.localeKey}}</span>
  {{else}}
    <span>{{item.title}}</span>
  {{/if}}
{{/if}}
{{#each item.buttons as |itemButton|}}
  <button
    type="button"
    class="ui {{itemButton.buttonClasses}} button"
    title={{itemButton.buttonTitle}}
    disabled={{itemButton.disabled}}
    {{action "buttonAction" itemButton.buttonAction bubbles=false}}>
      {{#if itemButton.iconClass}}
        <i class="{{itemButton.iconClass}}"></i>
      {{/if}}
      {{if itemButton.buttonName itemButton.buttonName}}
  </button>
{{/each}}
{{#if hasSubitems}}
  <div class="{{if item.itemsAlignment item.itemsAlignment}} menu">
    {{#each item.items as |item|}}
      {{flexberry-menuitem item=item}}
    {{/each}}
  </div>
{{/if}}
{{yield}}
