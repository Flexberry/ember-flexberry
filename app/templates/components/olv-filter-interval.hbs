<div
  class="olv-filter-interval"
  style={{filterIntervalStyle}}
>
  <div class="field" style="flex: 1; width: 100%;">
    {{component componentName
      value=from
      placeholder=fromPlaceholder
      dynamicProperties=dynProps
    }}
  </div>

  <div class="field" style="flex: 1; width: 100%;">
    {{component componentName
      value=to
      placeholder=toPlaceholder
      dynamicProperties=dynProps
    }}
  </div>
</div>