<div
  class="olv-filter-interval"
  style={{filterIntervalStyle}}
>
  {{#if (eq dynProps.type "date")}}
    <div class="field" style="flex: 1; width: 100%; display: flex; align-items: center; gap: 4px;">
      {{component componentName
        value=from
        placeholder=fromPlaceholder
        dynamicProperties=dynProps
      }}
      <button
        type="button"
        class="ui clear-filter mini icon button"
        style="margin-left: 4px;"
        title={{t "components.object-list-view.clear-filter-in-column"}}
        {{action "clearFrom"}}
      >
        <i class="remove icon"></i>
      </button>
    </div>

    <div class="field" style="flex: 1; width: 100%; display: flex; align-items: center; gap: 4px;">
      {{component componentName
        value=to
        placeholder=toPlaceholder
        dynamicProperties=dynProps
      }}
      <button
        type="button"
        class="ui clear-filter mini icon button"
        style="margin-left: 4px;"
        title={{t "components.object-list-view.clear-filter-in-column"}}
        {{action "clearTo"}}
      >
        <i class="remove icon"></i>
      </button>
    </div>
  {{else}}
    <div class="field" style="flex: 1; width: 100%;">
      {{component componentName
        value=from
        placeholder=fromPlaceholder
        dynamicProperties=dynProps
      }}
    </div>

    <div class="field" style="flex: 1; width: 100%;">
      {{component componentName
        value=to
        placeholder=toPlaceholder
        dynamicProperties=dynProps
      }}
    </div>
  {{/if}}
</div>
